{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ds": {
      "name": "DeepSeek (orchestrated)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "tool_call": true,
          "limit": { "context": 1000000, "output": 65536 }
        }
      }
    }
  },
  "mcp": {
    "claude_design": {
      "type": "remote",
      "url": "https://api.anthropic.com/v1/design/mcp",
      "enabled": true,
      "oauth": {
        "scope": "user:design:read user:design:write",
        "redirectUri": "http://localhost:19876/mcp/oauth/callback"
      },
      "timeout": 30000
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "deny",
      "npx eslint*": "allow",
      "npm run lint*": "allow",
      "node *": "allow",
      "git clone https://github.com/bhargavjoshi1237/geiger-events.git*": "allow",
      "git clone https://github.com/bhargavjoshi1237/geiger-content.git*": "allow",
      "Remove-Item -Recurse -Force C:\\Pro\\geiger-content*": "allow",
      "Copy-Item C:\\Pro\\geiger-events\\.env C:\\Pro\\geiger-content\\*": "allow",
      "npm install*": "allow",
      "Get-Content C:\\Pro\\geiger-content\\*": "allow",
      "Test-Path C:\\Pro\\geiger-content*": "allow",
      "Start-Process cmd*": "allow"
    }
  }
}
