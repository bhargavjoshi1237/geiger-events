{
  "expo": {
    "name": "Geiger Events",
    "slug": "bhargav-joshi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "geigerevents",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#161616",
    "ios": {
      "bundleIdentifier": "studio.geiger.events",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "studio.geiger.events",
      "adaptiveIcon": {
        "backgroundColor": "#161616",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161616",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#161616"
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://geigerevents.vercel.app/events",
      "router": {},
      "eas": {
        "projectId": "79fe52bd-cac4-4dc9-956c-c5bed0896f14"
      }
    },
    "owner": "bhargavjoshi1237s-team"
  }
}
